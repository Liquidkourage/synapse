    "date-fns-tz": "^3.2.0",
    "jose": "^6.2.3",
    "next": "16.2.1",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-rnd": "^10.5.3",
    "resend": "^6.10.0",
    "rss-parser": "^3.13.0",
