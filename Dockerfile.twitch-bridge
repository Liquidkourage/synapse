# Slim image for the Twitch → Synapse chat bridge only (no Next.js build, no DATABASE_URL at build).
# On Railway: set this service’s Dockerfile path to Dockerfile.twitch-bridge (not the root Dockerfile).
# Start command: leave empty (CMD below) or use: node scripts/twitch-chat-bridge.mjs
FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
# Skip postinstall (prisma generate) — bridge only needs tmi.js; avoids schema / DB at build.
RUN npm ci --omit=dev --ignore-scripts

COPY scripts/twitch-chat-bridge.mjs scripts/twitch-bot-token-bridge.mjs ./scripts/

ENV NODE_ENV=production

CMD ["node", "scripts/twitch-chat-bridge.mjs"]
