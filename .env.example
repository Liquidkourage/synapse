# Copy to .env

# PostgreSQL (Railway Postgres, Docker, local server, etc.). Prisma 7 uses @prisma/adapter-pg.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-long-random-string-at-least-32-chars"

# Public URL of the app (no trailing slash). Must match the browser: scheme + host + port.
# Examples: http://localhost:3000  |  https://localhost:8080  |  https://….up.railway.app
AUTH_URL="http://localhost:3000"

# Optional: hostname only (e.g. synapse.example.com) if Twitch/player embeds need parent= and
# x-forwarded-host is missing in your hosting setup.
# NEXT_PUBLIC_SITE_HOSTNAME="synapse.example.com"

# Optional: Resend — real welcome + reminder emails (https://resend.com)
# RESEND_API_KEY=
# Must be a verified sender/domain in Resend; dev default may work for testing
# RESEND_FROM_EMAIL="Synapse <onboarding@resend.dev>"

# Zoom (host-connected) — https://marketplace.zoom.us/ → build OAuth app + enable Meeting SDK
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# Optional override (default: {AUTH_URL}/api/zoom/oauth/callback)
# ZOOM_REDIRECT_URI=
# Meeting SDK signature (defaults to ZOOM_CLIENT_ID / ZOOM_CLIENT_SECRET if unset)
# ZOOM_MEETING_SDK_KEY=
# ZOOM_MEETING_SDK_SECRET=

# Built-in video — Daily.co (optional fallback: https://www.daily.co/pricing)
# 1) https://www.daily.co/ → sign up / log in
# 2) https://dashboard.daily.co/developers → API keys → create & copy
# 3) Paste below and restart the dev server
# DAILY_API_KEY="your_key_here"
# When set, new events get a Daily room unless you paste broadcastEmbedUrl or set:
# SYNAPSE_VIDEO_AUTO_ROOM=false
#
# Cloud recording on new Daily rooms (MP4; Daily bills usage — see pricing). Host starts recording in Prebuilt UI.
# Set to false if you don't want recording enabled at the room level:
# SYNAPSE_DAILY_CLOUD_RECORDING=false

# Merged Twitch ↔ Synapse chat (optional). Same secret for server + bridge machine.
# TWITCH_CHAT_INGEST_SECRET="generate-a-long-random-string"
# Bridge: TWITCH_BOT_USERNAME, TWITCH_BOT_OAUTH (chat:read), channels + ingest URLs
# Web + bridge: TWITCH_BOT_OAUTH with user:write:chat for Synapse → Twitch relay (Helix).
# Long-lived sessions (recommended): TWITCH_BOT_REFRESH_TOKEN + TWITCH_CLIENT_ID + TWITCH_CLIENT_SECRET
# (from OAuth code exchange — access tokens still ~4h but auto-refresh).
